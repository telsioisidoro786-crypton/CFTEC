{
  "builds": [
    { "src": "api/[...path].ts", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
