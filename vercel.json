{
  "builds": [
    { "src": "api/[...path].ts", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/portal", "dest": "/portal/index.html" },
    { "src": "/portal/(blog|blog-post|clientes|detalhes|faq|index)(?:/)?", "dest": "/portal/$1.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
